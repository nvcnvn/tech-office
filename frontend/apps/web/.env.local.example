# Zitadel Authentication Configuration
# Copy this file to .env.local and fill in the values

# Zitadel instance URL (issuer)
NEXT_PUBLIC_ZITADEL_ISSUER=https://techofficeinstance-elao17.us1.zitadel.cloud

# Zitadel application client ID (User Agent type, PKCE enabled)
NEXT_PUBLIC_ZITADEL_CLIENT_ID=341858311794190186

# Base URL for your application (used for redirect URIs)
# Local development: http://localhost:13000
# Production: https://transformar.work
NEXT_PUBLIC_BASE_URL=http://localhost:13000

# Backend API base URL used by Connect RPC and canonical-link endpoints
NEXT_PUBLIC_API_URL=http://localhost:18080
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080

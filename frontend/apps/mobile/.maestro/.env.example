# Copy this file to .env and fill in your test credentials
# Then run: maestro test .maestro/
MAESTRO_TEST_SUBDOMAIN=your-org-subdomain
MAESTRO_TEST_EMAIL=your-test-email@example.com
MAESTRO_TEST_PASSWORD=your-test-password
MAESTRO_TEST_PIN=123456
# Owner onboarding flow (onboarding/owner-signup.yaml). MAESTRO_RUN_ID must differ per run
# so repeated local runs do not collide on the derived workspace address; the runner sets a
# timestamp when it is not already exported.
MAESTRO_OWNER_PASSWORD=your-owner-password
MAESTRO_OWNER_PIN=314159
MAESTRO_RUN_ID=
MAESTRO_CANONICAL_TASK_LINK=http://localhost:3000/o/your-org/r/task/your-task-id
MAESTRO_CANONICAL_TASK_OPEN_LINK=techoffice:///o/your-org/r/task/your-task-id
MAESTRO_CANONICAL_ACCESS_DENIED_OPEN_LINK=techoffice:///o/your-org/r/task/your-private-task-id
MAESTRO_CANONICAL_NOT_FOUND_OPEN_LINK=techoffice:///o/your-org/r/task/your-missing-task-id
MAESTRO_CANONICAL_TASK_READY_TEXT=Your task title
MAESTRO_CANONICAL_PREVIEW_CHANNEL_ID=your-preview-channel-id
MAESTRO_NAV_TASK_PROJECT_ID=your-task-project-id
MAESTRO_NAV_TASK_ID=your-task-id
MAESTRO_NAV_CHANNEL_ID=your-channel-id
# Federated search flow (federated-search.yaml). One word that matches a document, a work
# item, an event and a file in the test workspace at once, plus that document's title.
MAESTRO_SEARCH_WORD=zarquon
MAESTRO_SEARCH_DOCUMENT_TITLE=Zarquon Closing Procedure
# Chat link previews flow (chat-link-previews.yaml). A task and a document the test user
# can see, their canonical links, and the text each one's card and screen shows — the
# flow posts a message carrying both links and asserts the cards name the resources.
MAESTRO_CANONICAL_TASK_TITLE=Your task title
MAESTRO_CANONICAL_TASK_IDENTIFIER=PROJ-123
MAESTRO_LINK_PREVIEW_DOCUMENT_LINK=http://localhost:3000/o/your-org/r/document/your-document-id
MAESTRO_LINK_PREVIEW_DOCUMENT_TITLE=Your document title

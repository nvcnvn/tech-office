# Maestro environment. Copy to .env — but for the standing suite, do not fill this in
# by hand. Every value in the first two sections is produced by one command:
#
#   cd backend && go run ./cmd seed-maestro-fixture > ../frontend/apps/mobile/.maestro/.env
#
# That command creates or refreshes the fixture workspace the suite signs into and
# prints a complete .env body to stdout (progress goes to stderr, so the redirect is
# safe). It is idempotent: running it again refreshes the same workspace rather than
# creating a second one, and re-emits the ids that changed.
#
# `make test-mobile` refuses to launch a flow while any standing-suite value below is
# missing or empty, and names the ones it cannot find.
#
# This file is tracked in git. Every value in it is a placeholder; no real credential
# belongs here.

# ---------------------------------------------------------------------------
# Standing suite — REQUIRED. Produced by seed-maestro-fixture.
# ---------------------------------------------------------------------------

# The fixture workspace and its primary account. Read by auth/signin.yaml (email +
# password) and auth/signin-known-device.yaml (email + PIN), which between them
# bootstrap nearly every other flow, and named directly by projects/create-project.yaml
# and rituals/create-ritual.yaml.
MAESTRO_TEST_SUBDOMAIN=maestro
MAESTRO_TEST_EMAIL=owner@maestro.maestro.invalid
MAESTRO_TEST_PASSWORD=your-fixture-owner-password
MAESTRO_TEST_PIN=123456

# Read by onboarding/owner-signup.yaml, which registers a BRAND-NEW workspace on every
# run. These are values the flow TYPES; they do not name a seeded account.
MAESTRO_OWNER_PASSWORD=your-signup-password
MAESTRO_OWNER_PIN=314159

# Read by screens/today.yaml (feature 047). The task id of the seeded overdue ritual
# instance, which is what the team-block row's testID carries. The signed-in account
# owns or administers the project holding it, and the instance is assigned to somebody
# else — a team block showing your own work is not a team block. The same workspace
# also carries one instance scheduled for today with nobody holding it, so the flow can
# assert the block's "Nobody assigned" row.
#
# This value changes on every re-seed. Do not hand-edit it.
MAESTRO_TEAM_TASK_ID=your-overdue-ritual-instance-task-id

# Read by federated-search.yaml (feature 045). One word that matches a document, a work
# item, an event and a file in the fixture workspace at once — the flow asserts all four
# result kinds come back together — plus the exact title of the document it then opens.
MAESTRO_SEARCH_WORD=zarquon
MAESTRO_SEARCH_DOCUMENT_TITLE=Zarquon Closing Procedure

# Read by people/directory-call.yaml and people/department-members.yaml (feature 048).
# Two colleagues searched by FAMILY name: one with a phone number recorded, one without.
# The absence is the assertion in the second case, so the seeder clears that field
# positively on every run. Plus a department with at least one member.
MAESTRO_DIRECTORY_PERSON_WITH_PHONE=Tran
MAESTRO_DIRECTORY_PERSON_NO_PHONE=Okafor
MAESTRO_DIRECTORY_DEPARTMENT=Store Floor

# Read by feature-tour/worker-tour.yaml, which needs an account WITHOUT the
# iam.inviteUser permission. That flow bootstraps through auth/signin.yaml and therefore
# reads MAESTRO_TEST_EMAIL, so run it with these values overriding that pair:
#
#   make test-mobile-one F=feature-tour/worker-tour \
#     MAESTRO_ENV_FLAGS="-e MAESTRO_TEST_EMAIL=... -e MAESTRO_TEST_PASSWORD=..."
#
# feature-tour/owner-tour.yaml uses the primary account above, which does hold it.
MAESTRO_WORKER_EMAIL=worker@maestro.maestro.invalid
MAESTRO_WORKER_PASSWORD=your-fixture-worker-password

# ---------------------------------------------------------------------------
# Emitted by the seeder, not required by the standing suite
# ---------------------------------------------------------------------------
#
# The worker's PIN sign-in pair. No flow in the standing suite reads them, so
# check-maestro-env does not demand them — a check that demands more than the suite
# needs is a check that blocks a valid run — but the seeder emits them so a single
# command produces a complete file.
MAESTRO_WORKER_LOGIN=maestro-worker
MAESTRO_WORKER_PIN=135791

# ---------------------------------------------------------------------------
# Generated per run — NEVER put a value here
# ---------------------------------------------------------------------------
#
# MAESTRO_RUN_ID is a timestamp the runner sets when it is not already exported.
# onboarding/owner-signup.yaml derives a workspace address from it, so a pinned value
# makes the second run collide on the address the first one claimed. The runner skips
# keys with an empty value, so the bare key below is harmless.
#
# MAESTRO_DEV_CLIENT_URL is resolved from the LAN IP by scripts/resolve-ip.sh, because
# the dev-client launcher only discovers Metro on the host it runs on and a physical
# device has nothing to tap.
MAESTRO_RUN_ID=
MAESTRO_DEV_CLIENT_URL=

# ---------------------------------------------------------------------------
# Individually-run flows — NOT part of the standing suite, NOT seeded
# ---------------------------------------------------------------------------
#
# These belong to canonical-resource-links.yaml, chat-link-previews.yaml and
# navigation-shared-routes-smoke.yaml, which run one at a time against purpose-built
# fixtures rather than against the seeded workspace:
#
#   make test-mobile-one F=canonical-resource-links
#   make test-mobile-one F=chat-link-previews
#
# The check-maestro-canonical-env and check-maestro-link-preview-env targets guard the
# first two. Extending the seeder to cover them is worth doing and is deliberately out
# of feature 061's scope: it is not what makes `make test-mobile` runnable.

# canonical-resource-links.yaml — a task link in each of its four states.
MAESTRO_CANONICAL_TASK_LINK=http://localhost:3000/o/your-org/r/task/your-task-id
MAESTRO_CANONICAL_TASK_OPEN_LINK=techoffice:///o/your-org/r/task/your-task-id
MAESTRO_CANONICAL_ACCESS_DENIED_OPEN_LINK=techoffice:///o/your-org/r/task/your-private-task-id
MAESTRO_CANONICAL_NOT_FOUND_OPEN_LINK=techoffice:///o/your-org/r/task/your-missing-task-id
MAESTRO_CANONICAL_TASK_READY_TEXT=Your task title
MAESTRO_CANONICAL_PREVIEW_CHANNEL_ID=your-preview-channel-id

# chat-link-previews.yaml — a task and a document the test user can see, their canonical
# links, and the text each one's card and screen shows. The flow posts a message
# carrying both links and asserts the cards name the resources.
MAESTRO_CANONICAL_TASK_TITLE=Your task title
MAESTRO_CANONICAL_TASK_IDENTIFIER=PROJ-123
MAESTRO_LINK_PREVIEW_DOCUMENT_LINK=http://localhost:3000/o/your-org/r/document/your-document-id
MAESTRO_LINK_PREVIEW_DOCUMENT_TITLE=Your document title

# navigation-shared-routes-smoke.yaml — one task and one channel to navigate to.
MAESTRO_NAV_TASK_PROJECT_ID=your-task-project-id
MAESTRO_NAV_TASK_ID=your-task-id
MAESTRO_NAV_CHANNEL_ID=your-channel-id

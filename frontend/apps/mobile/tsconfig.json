{
  "extends": "expo/tsconfig.base",
  "skipLibCheck": true,
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "src/**/*.check.ts"
  ]
}

{
    "compilerOptions": {
        "target": "es2020",
        "lib": [
            "es2020",
            "dom"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "declaration": true,
        "outDir": "dst",
        "strict": true,
        "esModuleInterop": true,
        "allowJs": true,
        "sourceMap": true,
        "jsx": "react-jsx",
        "skipLibCheck": true
    },
    "include": [
        "index.ts",
        "src"
    ]
}
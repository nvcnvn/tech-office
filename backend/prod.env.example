# Production environment template for the Tech Office backend.
#
# Inject real values through your deployment system or secret manager.
# Do not commit real credentials, LAN IPs, localhost URLs, or dev key paths.

# Core runtime
SERVER_PORT=18080
WEBAPP_URL=https://transformar.work
INSTANCE_ID=backend-prod-001
FLOW_SHARD_COUNT=32

# Database
DATABASE_URL=postgres://office:replace-with-db-password@replace-with-stackgres-rw-host:5432/office?sslmode=require
POSTGRES_DB=office
POSTGRES_USER=office
POSTGRES_PASSWORD=replace-with-db-password

# Internal JWT signing key
JWT_PRIVATE_KEY_PATH=/var/run/secrets/techoffice-jwt/jwt-private.pem

# Native push delivery via Firebase Admin
# Leave unset only if push is intentionally disabled for this environment.
GOOGLE_APPLICATION_CREDENTIALS=/var/run/secrets/techoffice-fcm/serviceAccount.json

# Transactional email via AWS SES
# If SES_FROM_EMAIL is empty, IAM emails are only logged.
AWS_REGION=ap-southeast-1
SES_FROM_EMAIL=no-reply@techoffice.example.com
SES_REPLY_TO_EMAIL=support@techoffice.example.com
SES_CONFIGURATION_SET=tech-office-prod

# File storage via Cloudflare R2
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=tech-office-prod
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://files.techoffice.example.com

# File scanning and document conversion
CLAMAV_HOST=clamav.tech-office-prod.svc.cluster.local
CLAMAV_PORT=3310
GOTENBERG_URL=http://gotenberg.tech-office-prod.svc.cluster.local:8081

# Voice and calling
LIVEKIT_URL=ws://livekit.tech-office-prod.svc.cluster.local:7880
PUBLIC_LIVEKIT_URL=wss://transformar.media.devguards.com
# Optional shared-secret form used by backend/k8s/base/backend/deployment.yaml.
# When LIVEKIT_API_KEY or LIVEKIT_API_SECRET is omitted, the backend can derive
# the first key pair from LIVEKIT_KEYS instead.
# LIVEKIT_KEYS=prodkey: replace-with-at-least-32-character-secret
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
VOICE_JOIN_TOKEN_TTL=5m
VOICE_MAX_PARTICIPANTS=32
VOICE_QUALITY_POLICY=balanced
VOICE_AUDIO_ONLY_BITRATE_KBPS=48

# Voice recording (optional)
# Falls back to the R2 bucket and credentials when these are left aligned.
VOICE_RECORDING_ENABLED=false
VOICE_RECORDING_BUCKET=tech-office-prod
VOICE_RECORDING_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
VOICE_RECORDING_REGION=auto
VOICE_RECORDING_ACCESS_KEY_ID=replace-with-recording-access-key
VOICE_RECORDING_SECRET_ACCESS_KEY=replace-with-recording-secret-key
VOICE_RECORDING_FORCE_PATH_STYLE=true
VOICE_RECORDING_PREFIX=voice-recordings

# Voice transcription (optional)
VOICE_TRANSCRIPTION_ENABLED=false
WHISPER_API_URL=http://whisper.tech-office-prod.svc.cluster.local:8000
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=

# File limits
DEFAULT_MAX_FILE_SIZE_BYTES=104857600
DEFAULT_QUOTA_BYTES=0

# ============================================================================
# Frontend-only SSO configuration (set these at web image build time)
# ============================================================================
#
# Google OAuth Web Client ID
#   Create at: https://console.cloud.google.com/ → APIs & Services → Credentials
#   Authorized JavaScript origins (no trailing slash):
#     https://transformar.work
#     http://localhost:13000  (dev only)
#   Authorized redirect URIs: not needed for the GIS credential flow.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
#
# Apple Sign-In Service ID
#   Create at: https://developer.apple.com/account/resources/identifiers/list/serviceId
#   Enable "Sign In with Apple" and configure:
#     Domains and Subdomains: transformar.work
#     Return URLs:            https://transformar.work/signin
#   (For local dev: add localhost as domain, http://localhost:13000/signin as return URL)
# NEXT_PUBLIC_APPLE_CLIENT_ID=work.transformar.web

# ============================================================================
# Backend SSO audience validation (REQUIRED for production security)
# ============================================================================
# Comma-separated list of all Google OAuth Client IDs whose tokens the backend
# will accept. Include every platform client (web, iOS, Android).
# Tokens whose `aud` claim does not match one of these values will be rejected.
# GOOGLE_CLIENT_IDS=replace-with-web-client-id.apps.googleusercontent.com,replace-with-ios-client-id.apps.googleusercontent.com
#
# Comma-separated list of all Apple Service IDs and app bundle IDs whose tokens
# the backend will accept (web Service ID + native bundle ID).
# APPLE_CLIENT_IDS=work.transformar.web,work.transformar.app
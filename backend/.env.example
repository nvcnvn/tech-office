# Database Configuration
DATABASE_URL=postgres://postgres:tech_office_password@localhost:15432/tech_office_db?sslmode=disable
FLOW_SHARD_COUNT=1
POSTGRES_DB=tech_office_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tech_office_password
WEBAPP_URL=http://localhost:13000

# AWS SES Configuration (transactional email)
# If SES_FROM_EMAIL is empty, password reset and invitation emails are logged locally instead.
# AWS credentials can come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an attached IAM role.
AWS_REGION=
SES_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET=

# Internal JWT Configuration
# Private key for signing JWTs (public key derived automatically)
# If not set, an ephemeral key is generated (dev only — tokens won't survive restarts)
JWT_PRIVATE_KEY_PATH=.dev-keys/jwt-private.pem

# Firebase Cloud Messaging Configuration (T054)
# Option 1: Path to service account JSON file (preferred for local dev)
GOOGLE_APPLICATION_CREDENTIALS=.dev-keys/techoffice-dev-firebase-adminsdk-fbsvc-2e55cd0cc8.json

# Option 2: Inline JSON string (alternative for environments without filesystem access)
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Optional: Explicit project ID (can be derived from service account)
# FCM_PROJECT_ID=your-firebase-project-id

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# LiveKit Voice Configuration
# PUBLIC_LIVEKIT_URL is the URL sent to clients in join credentials.
# On simulators/web the default (ws://localhost:7880) works fine.
# For real mobile devices on a LAN, set this to your machine's LAN IP:
#   PUBLIC_LIVEKIT_URL=ws://192.168.x.x:7880
# LIVEKIT_URL=ws://localhost:7880
# PUBLIC_LIVEKIT_URL=
# LIVEKIT_KEYS=devkey: devsecretdevsecretdevsecretdevsecret
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
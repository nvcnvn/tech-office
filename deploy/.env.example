# Tech Office — on-prem deployment configuration.
#
#   cp deploy/.env.example deploy/.env   &&   edit   &&   deploy/scripts/bootstrap.sh
#
# Every stack file and script reads this one file. Values marked REQUIRED have no
# safe default; the bootstrap script refuses to continue while they are unset.

# --- Release -----------------------------------------------------------------
# Tag of the project's published images (backend, migrate, postgres). `latest` follows
# the newest release; pin it to a release tag such as v0.1.0 for a fleet you want to
# upgrade deliberately. Must be a tag that exists in REGISTRY.
RELEASE_TAG=latest
# Tag of YOUR locally built web image. build-images.sh writes the tag it produced here;
# there is no reason to edit it by hand.
WEB_TAG=dev
# Overrides the whole web image reference, ignoring WEB_REGISTRY and the local build.
# Only useful for a deployment whose web image is already published somewhere.
WEB_IMAGE=
# Registry every node pulls from. The project publishes its images to the GitHub
# Container Registry:
#   REGISTRY=ghcr.io/nvcnvn
# Leave empty only for a single-machine fleet building its own images locally, or
# point it at deploy/stacks/registry.yml (REGISTRY=10.0.0.1:5000) for an air-gapped
# fleet. Note the web image is always built locally — see deploy/README.md.
REGISTRY=ghcr.io/nvcnvn

# Where YOUR web image goes. It cannot come from the project's registry: Next.js bakes
# NEXT_PUBLIC_* in at build time, so the web image is welded to your hostnames and you
# build it yourself. Leave empty on a single machine (the local image is enough); on a
# larger fleet set it to a registry you can push to — your own ghcr namespace, or the
# `registry` profile (WEB_REGISTRY=10.0.0.1:5000).
#
# The one exception is the project's own hosted deployment: it pulls the prebuilt
# ghcr.io/nvcnvn/tech-office-web-transformar instead of building, by setting
#   WEB_IMAGE=ghcr.io/nvcnvn/tech-office-web-transformar
# That image points at transformar.work — do not use it for your own site.
WEB_REGISTRY=

# --- Public names ------------------------------------------------------------
WEB_DOMAIN=office.example.com
API_DOMAIN=api.office.example.com
MEDIA_DOMAIN=media.office.example.com

# acme  = Traefik obtains Let's Encrypt certificates over HTTP-01 (needs port 80
#         reachable from the internet and public DNS for the three names above).
# file  = you supply deploy/secrets/tls.crt and deploy/secrets/tls.key
#         (internal CA, wildcard, air-gapped LAN).
TLS_MODE=acme
ACME_EMAIL=ops@example.com

# Which stack profiles are deployed. Anything not listed here is REMOVED from the
# fleet on the next deploy — that is how you opt out of, say, our observability stack.
#   voice processing backup observability registry
PROFILES="voice processing backup observability"

# --- Fleet -------------------------------------------------------------------
# Node labels the stacks place on. bootstrap.sh applies them; on a one-machine
# fleet every role lands on the same node.
# Roles: edge (Traefik), db (Postgres + backup), app (backend + web),
#        voice (LiveKit), processing (ClamAV/Gotenberg/Whisper), obs.
# Two is enough to survive a start-first rolling update with one replica always
# serving; the update briefly runs a third, which is what PG_MAX_CONNECTIONS
# below is sized against. Three only buys headroom this box does not have.
BACKEND_REPLICAS=2
WEB_REPLICAS=2

# --- Database ----------------------------------------------------------------
POSTGRES_DB=office
POSTGRES_USER=office
POSTGRES_PASSWORD=                       # REQUIRED
# Reachable from the backend over the overlay network. Keep the host as `postgres`.
DATABASE_URL=postgres://office:CHANGE_ME@postgres:5432/office?sslmode=disable
FLOW_SHARD_COUNT=32
# Tuning for the reference box: OVH Advance-1 (AMD EPYC 4245P, 6c/12t, 32 GB
# DDR5, 2x960 GB NVMe soft RAID) running the WHOLE stack, not a dedicated db
# node — so this is not the usual "25% of RAM". deploy/README.md "Sizing" shows
# the budget. Scale all four together if you move to a bigger machine.
PG_SHARED_BUFFERS=4GB
# Matches the 10G cgroup ceiling on the postgres service in core.yml. A cgroup
# memory limit also caps the page cache charged to it, so promising the planner
# more OS cache than that would be a lie.
PG_EFFECTIVE_CACHE_SIZE=10GB
# Per sort/hash node, not per connection, and hash nodes get 2x this
# (hash_mem_multiplier). Worst case is roughly concurrent_queries * nodes * 32MB.
PG_WORK_MEM=16MB
# Ceiling, derived from the pools, not a wish. Each replica opens three pools
# with different ceilings (backend/database/pool.go): tenant 8, admin 6, flow 3.
#   17 x (BACKEND_REPLICAS + 1 mid-rolling-update) = 17 x 3 = 51
#   + ~12 for postgres-exporter, pgBackRest, migrations and your psql
#   + 5 reserved for superusers
# TestFleetWideConnectionCeiling in backend/database/pool_test.go fails if this
# and the pool ceilings ever drift apart. Raising it without raising the box's
# RAM buys nothing: 6 cores cannot run more than a couple of dozen queries at
# once anyway, and every idle backend still costs memory.
PG_MAX_CONNECTIONS=80

# --- Backup (S3 / Cloudflare R2) — pgBackRest --------------------------------
# Physical backup + WAL archiving. This is the only thing standing between you
# and permanent data loss; verify-restore.sh proves it works.
BACKUP_S3_BUCKET=                        # REQUIRED
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto                    # R2: auto. AWS: the real region.
BACKUP_S3_KEY=                           # REQUIRED
BACKUP_S3_KEY_SECRET=                    # REQUIRED
BACKUP_S3_URI_STYLE=path                 # path for R2/MinIO, host for AWS S3
# Backups are encrypted client-side. Store this passphrase somewhere other than
# this file — without it the backups are unreadable. bootstrap.sh generates one.
BACKUP_CIPHER_PASS=                      # REQUIRED
# Keep this many full backups (with their diffs/incrementals and WAL).
BACKUP_RETENTION_FULL=4
# Schedule, evaluated hourly by the backup service.
BACKUP_FULL_ON_WEEKDAY=0                 # 0=Sunday
BACKUP_FULL_AT_HOUR=2
BACKUP_DIFF_AT_HOUR=14
# Any other hour takes an incremental. Set to 0 to only take full+diff.
BACKUP_INCREMENTAL_ENABLED=1

# --- Object storage for user files (R2/S3) -----------------------------------
# Every uploaded file, avatar and recording lives here. The backend refuses to start
# without the first four — it has no local-disk fallback — so this is not optional
# even for a deployment that does not expect many uploads.
R2_ACCESS_KEY_ID=                        # REQUIRED
R2_SECRET_ACCESS_KEY=                    # REQUIRED
R2_BUCKET_NAME=                          # REQUIRED
R2_ENDPOINT=                             # REQUIRED
# Public base URL files are served from, if the bucket has one.
R2_PUBLIC_URL=

# --- Email (AWS SES). Empty SES_FROM_EMAIL = emails are logged, not sent. ----
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET=

# --- Voice / LiveKit ---------------------------------------------------------
# At least 32 characters. bootstrap.sh generates one if left empty.
LIVEKIT_API_KEY=techoffice
LIVEKIT_API_SECRET=

# How WebRTC media reaches the voice node. Either way the ports below must be open
# on that node's firewall — media never goes through Traefik.
#
#   mux   one muxed UDP port, LiveKit on the overlay network. One firewall rule,
#         one published port. All media shares a socket, which is the first thing
#         to feel contention as rooms and bitrate grow. Fine for a small office.
#   host  a real UDP port range on the voice node's own network stack. The shape
#         LiveKit prefers for scale; needs LIVEKIT_HOST and the whole range open.
LIVEKIT_TRANSPORT=mux
LIVEKIT_TCP_PORT=7881
# mux only:
LIVEKIT_UDP_PORT=7882
# host only — the voice node's internal IP, and the media range:
LIVEKIT_HOST=
LIVEKIT_UDP_RANGE_START=5000
LIVEKIT_UDP_RANGE_END=6000
# Address clients must send media to.
#   Internet-facing: leave empty, LiveKit discovers its public IP over STUN.
#   LAN-only:        set the voice node's LAN IP.
LIVEKIT_NODE_IP=
VOICE_MAX_PARTICIPANTS=32
VOICE_QUALITY_POLICY=balanced
VOICE_RECORDING_ENABLED=false
VOICE_TRANSCRIPTION_ENABLED=false
WHISPER_MODEL=base

# --- Push notifications ------------------------------------------------------
# FCM (Android + web): put the service account JSON at deploy/secrets/fcm.json
# APNs VoIP (iOS calls): put the .p8 at deploy/secrets/apns.p8 and fill these in.
APNS_VOIP_KEY_ID=
APNS_VOIP_TEAM_ID=
APNS_VOIP_TOPIC=
APNS_VOIP_USE_SANDBOX=false

# --- SSO ---------------------------------------------------------------------
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# --- Limits ------------------------------------------------------------------
DEFAULT_MAX_FILE_SIZE_BYTES=104857600
DEFAULT_QUOTA_BYTES=0

# --- Observability (only used by the `observability` profile) ----------------
# OpenObserve: metrics storage, PromQL, dashboards and alerting in one container.
OBSERVE_ROOT_EMAIL=admin@example.com
OBSERVE_ROOT_PASSWORD=                   # generated by bootstrap.sh
OBSERVE_ORG=default
# Metrics older than this are compacted away. Minimum 3.
OBSERVE_RETENTION_DAYS=30
# Where fired alerts are delivered (Slack incoming webhook, or any endpoint that
# accepts a JSON POST). Empty means alerts fire into the OpenObserve UI only.
OBSERVE_ALERT_WEBHOOK_URL=

# Tech Office — on-prem deployment configuration.
#
#   cp deploy/.env.example deploy/.env   &&   edit   &&   deploy/scripts/bootstrap.sh
#
# Every stack file and script reads this one file. Values marked REQUIRED have no
# safe default; the bootstrap script refuses to continue while they are unset.

# --- Release -----------------------------------------------------------------
# Image tag deployed by deploy.sh. build-images.sh writes the tag it produced here.
RELEASE_TAG=dev
# Registry every node can pull from. Leave empty ONLY for a single-machine fleet
# (images then have to exist locally on that machine).
#   Local option: deploy/stacks/registry.yml, then REGISTRY=10.0.0.1:5000
REGISTRY=

# --- Public names ------------------------------------------------------------
WEB_DOMAIN=office.example.com
API_DOMAIN=api.office.example.com
MEDIA_DOMAIN=media.office.example.com

# acme  = Traefik obtains Let's Encrypt certificates over HTTP-01 (needs port 80
#         reachable from the internet and public DNS for the three names above).
# file  = you supply deploy/secrets/tls.crt and deploy/secrets/tls.key
#         (internal CA, wildcard, air-gapped LAN).
TLS_MODE=acme
ACME_EMAIL=ops@example.com

# --- Fleet -------------------------------------------------------------------
# Node labels the stacks place on. bootstrap.sh applies them; on a one-machine
# fleet every role lands on the same node.
# Roles: edge (Traefik), db (Postgres + backup), app (backend + web),
#        voice (LiveKit), processing (ClamAV/Gotenberg/Whisper), obs.
BACKEND_REPLICAS=3
WEB_REPLICAS=2

# --- Database ----------------------------------------------------------------
POSTGRES_DB=office
POSTGRES_USER=office
POSTGRES_PASSWORD=                       # REQUIRED
# Reachable from the backend over the overlay network. Keep the host as `postgres`.
DATABASE_URL=postgres://office:CHANGE_ME@postgres:5432/office?sslmode=disable
FLOW_SHARD_COUNT=32
# Tuning for the db node. shared_buffers ~25% of its RAM.
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_MAX_CONNECTIONS=300

# --- Backup (S3 / Cloudflare R2) — pgBackRest --------------------------------
# Physical backup + WAL archiving. This is the only thing standing between you
# and permanent data loss; verify-restore.sh proves it works.
BACKUP_S3_BUCKET=                        # REQUIRED
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto                    # R2: auto. AWS: the real region.
BACKUP_S3_KEY=                           # REQUIRED
BACKUP_S3_KEY_SECRET=                    # REQUIRED
BACKUP_S3_URI_STYLE=path                 # path for R2/MinIO, host for AWS S3
# Backups are encrypted client-side. Store this passphrase somewhere other than
# this file — without it the backups are unreadable. bootstrap.sh generates one.
BACKUP_CIPHER_PASS=                      # REQUIRED
# Keep this many full backups (with their diffs/incrementals and WAL).
BACKUP_RETENTION_FULL=4
# Schedule, evaluated hourly by the backup service.
BACKUP_FULL_ON_WEEKDAY=0                 # 0=Sunday
BACKUP_FULL_AT_HOUR=2
BACKUP_DIFF_AT_HOUR=14
# Any other hour takes an incremental. Set to 0 to only take full+diff.
BACKUP_INCREMENTAL_ENABLED=1

# --- Object storage for user files (R2/S3) -----------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Email (AWS SES). Empty SES_FROM_EMAIL = emails are logged, not sent. ----
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET=

# --- Voice / LiveKit ---------------------------------------------------------
# At least 32 characters. bootstrap.sh generates one if left empty.
LIVEKIT_API_KEY=techoffice
LIVEKIT_API_SECRET=
# WebRTC media reaches the voice node directly on these ports — open them on the
# firewall. A single muxed UDP port, not a range.
LIVEKIT_UDP_PORT=7882
LIVEKIT_TCP_PORT=7881
# Address clients must send media to.
#   Internet-facing: leave empty, LiveKit discovers its public IP over STUN.
#   LAN-only:        set the voice node's LAN IP.
LIVEKIT_NODE_IP=
VOICE_MAX_PARTICIPANTS=32
VOICE_QUALITY_POLICY=balanced
VOICE_RECORDING_ENABLED=false
VOICE_TRANSCRIPTION_ENABLED=false
WHISPER_MODEL=base

# --- Push notifications ------------------------------------------------------
# FCM (Android + web): put the service account JSON at deploy/secrets/fcm.json
# APNs VoIP (iOS calls): put the .p8 at deploy/secrets/apns.p8 and fill these in.
APNS_VOIP_KEY_ID=
APNS_VOIP_TEAM_ID=
APNS_VOIP_TOPIC=
APNS_VOIP_USE_SANDBOX=false

# --- SSO ---------------------------------------------------------------------
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# --- Limits ------------------------------------------------------------------
DEFAULT_MAX_FILE_SIZE_BYTES=104857600
DEFAULT_QUOTA_BYTES=0

# --- Observability (only used by the `observability` profile) ----------------
GRAFANA_ADMIN_PASSWORD=
# Where alerts go. Leave empty to keep them in Alertmanager's UI only.
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# Prometheus scrape configuration. Rendered by deploy/scripts/lib.sh.
#
# `tasks.<service>` is Swarm's DNS record listing every task of a service, which is
# how the global exporters (one per node) are all discovered. Plain `<service>`
# resolves to the load-balanced VIP and would only ever scrape one of them.
global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    deployment: ${WEB_DOMAIN}

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    dns_sd_configs:
      - names: ["tasks.node-exporter"]
        type: A
        port: 9100

  - job_name: containers
    dns_sd_configs:
      - names: ["tasks.cadvisor"]
        type: A
        port: 8080

  - job_name: postgres
    static_configs:
      - targets: ["postgres-exporter:9187"]

  - job_name: traefik
    static_configs:
      - targets: ["traefik:8082"]

  # LiveKit publishes Prometheus metrics only when `prometheus_port` is set in its
  # config; left off by default because the SFU's own logs cover a fleet this size.

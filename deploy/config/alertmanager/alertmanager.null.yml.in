# No notification channel configured (ALERT_SLACK_WEBHOOK_URL is empty). Alerts still
# fire and are visible in the Alertmanager UI on the obs node; they are not delivered.
route:
  receiver: none
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

receivers:
  - name: none

inhibit_rules:
  - source_matchers: [severity = critical]
    target_matchers: [severity = warning]
    equal: [instance]
